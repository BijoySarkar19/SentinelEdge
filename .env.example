# =============================================================================
# SentinelEdge — Complete Environment Configuration Template
# Privacy-First Edge-to-Cloud Real-Time Video & Incident Intelligence Platform
# Copy this file to .env before starting the system:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application Runtime
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 2. PostgreSQL 16 + pgvector Database
# -----------------------------------------------------------------------------
# Used by FastAPI / SQLAlchemy async engine (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://sentinel:sentinelpass@localhost:5432/sentineledge

# Database parameters used directly by docker-compose / postgres container
POSTGRES_DB=sentineledge
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinelpass
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# 3. Redis 7.4 Streams Event Broker
# -----------------------------------------------------------------------------
# Connection URL for real-time Streams broker & cache
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=sentinelredispass
REDIS_PORT=6379

# Event broker selection: 'redis' (default) or 'kafka' / 'redpanda'
EVENT_BROKER=redis
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
REDPANDA_BOOTSTRAP_SERVERS=localhost:9092

# -----------------------------------------------------------------------------
# 4. Authentication, JWT & Security
# -----------------------------------------------------------------------------
# Cryptographically secure 256-bit secret key for HMAC-SHA256 tokens
JWT_SECRET_KEY=e4f9b8c2d1a34790b5e8c1f3a7d2e9b0c5a8f1e3d7b9c2a4f6e8b0d2c4a6e8f0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 5. Bootstrap Administrator Account (Auto-provisioned on initial boot)
# -----------------------------------------------------------------------------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@sentineledge.local
BOOTSTRAP_ADMIN_PASSWORD=Admin@Sentinel2026!

# -----------------------------------------------------------------------------
# 6. Semantic Embeddings & NLP (pgvector Search)
# -----------------------------------------------------------------------------
# Compact 384-dimensional sentence transformer model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# -----------------------------------------------------------------------------
# 7. Edge Computer Vision & Hardware Inference
# -----------------------------------------------------------------------------
# Target: NVIDIA GeForce RTX 3050 Laptop GPU (6GB VRAM) with automatic CPU fallback
INFERENCE_DEVICE=auto
INFERENCE_IMAGE_SIZE=640
INFERENCE_CONFIDENCE=0.35
INFERENCE_FRAME_SKIP=2
INFERENCE_FP16=true
YOLO_MODEL=yolov8n.pt

# -----------------------------------------------------------------------------
# 8. Privacy Anonymization & Data Protection
# -----------------------------------------------------------------------------
# Privacy modes: 'metadata_only' (zero raw video leaves RAM) or 'blur'
PRIVACY_MODE=metadata_only
FACE_DETECTOR_MODEL=yunet
PLATE_DETECTOR_MODEL=models/plate_detector.onnx
ANONYMIZATION_METHOD=gaussian_blur
STORE_BLURRED_EVIDENCE=false
RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# 9. Edge Camera & Ingestion Target
# -----------------------------------------------------------------------------
CAMERA_ID=CAM-01
CAMERA_NAME=Main Facility Perimeter North
SOURCE_URI=0
BACKEND_API_URL=http://localhost:8000
INGEST_ENDPOINT=/api/v1/incidents/ingest

# -----------------------------------------------------------------------------
# 10. Web Console, API Routing & CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/events
CORS_ORIGINS=http://localhost:3000,http://localhost:3005

# Service host port mappings (Prevents collisions with external containers)
BACKEND_PORT=8000
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# 11. Telemetry, Prometheus & Grafana Monitoring
# -----------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# -----------------------------------------------------------------------------
# 12. Rate Limiting & Abuse Prevention
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
