# =============================================================================
# SentinelEdge — Production Environment Configuration (.env.production)
# Instructions: Copy this file to .env.production and supply real secrets.
# =============================================================================

# --- 1. Platform Identity & Environment ---
APP_NAME=SentinelEdge
APP_ENV=production
LOG_LEVEL=WARNING
API_BASE_URL=https://sentinel.yourdomain.com
NEXT_PUBLIC_API_URL=https://sentinel.yourdomain.com
NEXT_PUBLIC_WS_URL=wss://sentinel.yourdomain.com

# --- 2. Production Gateway & Ports ---
PROD_HTTP_PORT=80
PROD_HTTPS_PORT=443
BACKEND_PORT=8000
FRONTEND_PORT=3000
GRAFANA_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- 3. Database Credentials (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=sentinel_prod
POSTGRES_PASSWORD=ReplaceWithStrongProdPass_Min32Chars!
POSTGRES_DB=sentineledge_prod
DATABASE_URL=postgresql+asyncpg://sentinel_prod:ReplaceWithStrongProdPass_Min32Chars!@postgres:5432/sentineledge_prod

# --- 4. Event Broker (Redis 7.4 Streams) ---
REDIS_URL=redis://redis:6379/0
REDIS_TOPIC_INCIDENTS=sentinel.incidents
REDIS_CONSUMER_GROUP=sentinel_prod_group

# --- 5. Security, Cryptography & JWT ---
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=e4f9b2d88195a4325a77cb8912efc40590a21d58231c5f3b79a09845e61234bc
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- 6. Bootstrap Administrator Account ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@sentinel.yourdomain.com
BOOTSTRAP_ADMIN_PASSWORD=Admin@SentinelProd2026!

# --- 7. Application Server Workers ---
BACKEND_WORKERS=4
CORS_ORIGINS=["https://sentinel.yourdomain.com","https://console.sentinel.yourdomain.com"]

# --- 8. Computer Vision & Privacy Engine ---
INFERENCE_DEVICE=auto
YOLO_MODEL=yolov8n.pt
DETECTION_CONF_THRESHOLD=0.35
BYTETRACK_MATCH_THRESH=0.75
PRIVACY_MODE=metadata_only
BLUR_KERNEL_SIZE=51
PIXELATION_BLOCK_SIZE=16
SOURCE_URI=0

# --- 9. Vector Embeddings (pgvector) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384

# --- 10. Observability (Prometheus & Grafana) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=Grafana@SentinelProd2026!
GRAFANA_ROOT_URL=https://sentinel.yourdomain.com:3001
